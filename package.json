{
  "name": "neighborhood-listing-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run src",
    "test:e2e": "playwright test tests/e2e/core-flow.spec.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "check:migrations": "supabase db push --dry-run",
    "test:rls": "node --env-file-if-exists=.env.local scripts/test-rls.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "rollback:production": "bash scripts/rollback-production.sh"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
